<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pantry_green</item>
        <item name="colorPrimaryVariant">@color/pantry_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/pantry_orange</item>
        <item name="colorSecondaryVariant">@color/pantry_orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorSecondaryContainer">@color/pantry_green_light</item>

        <item name="android:colorBackground">@color/pantry_cream</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/pantry_text_dark</item>
        <item name="colorSurfaceVariant">@color/pantry_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/pantry_text_dark</item>
        <item name="colorControlNormal">@color/pantry_green</item>

        <item name="android:statusBarColor">@color/pantry_green_dark</item>
        <item name="android:navigationBarColor">@color/pantry_cream</item>
    </style>

    <style name="Theme.SmartPantryManager" parent="Base.Theme.SmartPantryManager" />
</resources>